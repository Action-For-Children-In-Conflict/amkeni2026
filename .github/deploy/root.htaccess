# Serve the Laravel application from the public/ folder while keeping the
# application root private. Uploaded to public_html by the deploy workflow.
<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Defence in depth in case rewriting is unavailable.
<IfModule mod_authz_core.c>
    <FilesMatch "(^\.env|^composer\.(json|lock)$|^artisan$)">
        Require all denied
    </FilesMatch>
</IfModule>
